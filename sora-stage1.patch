From 656af43d6b7cfdaf48aa5bfd5edec2af69aa91b2 Mon Sep 17 00:00:00 2001
From: Sora Dev <dev@sora.local>
Date: Tue, 27 Oct 2026 13:48:21 +0000
Subject: [PATCH 5/6] fix(a11y): no focus ring on <main> after navigating

AppLayout focuses <main> after each navigation for screen readers. The global :focus-visible rule beat the
outline-none utility (unlayered CSS wins over @layer utilities), drawing a stray accent-coloured line down the page edge.
---
 client/src/index.css | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/client/src/index.css b/client/src/index.css
index 7b04167..fafad60 100644
--- a/client/src/index.css
+++ b/client/src/index.css
@@ -236,6 +236,12 @@ body {
   outline-offset: 2px;
 }
 
+/* <main> is focused by code after you navigate (see AppLayout) so screen readers land on the new page.
+   It isn't a control, so it shouldn't draw a ring. (Utility classes lose to this unlayered rule, hence the override.) */
+#main-content:focus-visible {
+  outline: none;
+}
+
 /* Respect the OS "reduce motion" setting: no transitions or spinners-as-animation. */
 @media (prefers-reduced-motion: reduce) {
   *,
-- 
