generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AssignmentKind {
  ASSIGNMENT
  EXAM
}

enum GameStatus {
  PLAYING
  COMPLETED
  BACKLOG
  WISHLIST
}

enum ReadingStatus {
  READING
  COMPLETED
  WANT_TO_READ
}

enum WatchStatus {
  WATCHING
  COMPLETED
  WATCHLIST
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks   Task[]
  notes   Note[]
  events  Event[]
  habits  Habit[]
  goals   Goal[]

  subjects      Subject[]
  assignments   Assignment[]
  studySessions StudySession[]
  grades        Grade[]
  expenses      Expense[]
  budgets       Budget[]
  games         Game[]
  books         Book[]
  movies        Movie[]
  memories      Memory[]
  places        Place[]

  @@map("users")
}

model Habit {
  id        String   @id @default(uuid())
  name      String
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions HabitCompletion[]

  @@index([userId])
  @@map("habits")
}

model HabitCompletion {
  id        String   @id @default(uuid())
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  habitId String
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId])
  @@map("habit_completions")
}

model Goal {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String?
  deadline    DateTime? @db.Date
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones GoalMilestone[]

  @@index([userId])
  @@map("goals")
}

model GoalMilestone {
  id        String   @id @default(uuid())
  title     String
  completed Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("goal_milestones")
}

model Task {
  id                 String              @id @default(uuid())
  title              String
  description        String?
  status             TaskStatus          @default(TODO)
  priority           Priority            @default(MEDIUM)
  category           String?
  tags               String[]            @default([])
  dueDate            DateTime?           @db.Date
  dueTime            String?
  recurringFrequency RecurringFrequency?
  completedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, dueDate])
  @@index([userId, status])
  @@map("tasks")
}

model Note {
  id        String   @id @default(uuid())
  title     String
  content   String   @default("")
  tags      String[] @default([])
  pinned    Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, archived])
  @@map("notes")
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String?
  location    String?
  category    String   @default("Event")
  date        DateTime @db.Date
  startTime   String?
  endTime     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
  @@map("events")
}

model Subject {
  id        String   @id @default(uuid())
  name      String
  code      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments   Assignment[]
  studySessions StudySession[]
  grades        Grade[]

  @@index([userId])
  @@map("subjects")
}

model Assignment {
  id        String         @id @default(uuid())
  title     String
  kind      AssignmentKind @default(ASSIGNMENT)
  dueDate   DateTime       @db.Date
  completed Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate])
  @@map("assignments")
}

model StudySession {
  id        String   @id @default(uuid())
  date      DateTime @db.Date
  minutes   Int
  notes     String?
  createdAt DateTime @default(now())

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("study_sessions")
}

model Grade {
  id        String   @id @default(uuid())
  title     String
  score     Float
  maxScore  Float    @default(100)
  createdAt DateTime @default(now())

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("grades")
}

model Expense {
  id          String   @id @default(uuid())
  amount      Decimal  @db.Decimal(12, 2)
  category    String
  description String?
  date        DateTime @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("expenses")
}

model Budget {
  id        String   @id @default(uuid())
  month     String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@map("budgets")
}

model Game {
  id        String     @id @default(uuid())
  title     String
  status    GameStatus @default(BACKLOG)
  platform  String?
  rating    Int?
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("games")
}

model Book {
  id          String        @id @default(uuid())
  title       String
  author      String?
  status      ReadingStatus @default(WANT_TO_READ)
  totalPages  Int?
  currentPage Int           @default(0)
  rating      Int?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("books")
}

model Movie {
  id        String      @id @default(uuid())
  title     String
  kind      String      @default("Movie")
  status    WatchStatus @default(WATCHLIST)
  rating    Int?
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("movies")
}

model Memory {
  id          String   @id @default(uuid())
  title       String
  description String?
  date        DateTime @db.Date
  location    String?
  tags        String[] @default([])
  photos      String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("memories")
}

model Place {
  id          String    @id @default(uuid())
  name        String
  location    String?
  visitedDate DateTime? @db.Date
  rating      Int?
  notes       String?
  photos      String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("places")
}
